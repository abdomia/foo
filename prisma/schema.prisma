generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  password           String
  phone              String
  parentPhone        String
  avatar             String?
  grade              String?
  isSubscribed       Boolean            @default(false)
  subscriptionPlan   String?
  subscriptionExpiry DateTime?
  isAdmin            Boolean            @default(false)
  role               String             @default("student") // student | parent
  parentStudents     ParentStudent[]    @relation("ParentStudents")
  children           ParentStudent[]    @relation("ParentChildren")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  payments           Payment[]
  subscriptions      Subscription[]
  quizProgress       UserQuizProgress[]
  lessonProgress     UserLessonProgress[]
  sessions           Session[]
  favorites          Favorite[]
  notifications      Notification[]
  xp                 Int                @default(0)
  level              Int                @default(1)
  streak             Int                @default(0)
  streakBest         Int                @default(0)
  lastActiveDate     DateTime?
  questionsAnswered  Int                @default(0)
  quizzesTaken       Int                @default(0)
  unitsCompleted     Int                @default(0)
  xpLogs             XpLog[]
  badges             Badge[]
  certificates       Certificate[]

  @@index([role, createdAt])
  @@index([lastActiveDate])
}

// Links a parent account (User.role = "parent") to a student.
// `canEdit` is an explicit permission: without it the parent can only view.
model ParentStudent {
  id        String   @id @default(cuid())
  parentId  String
  parent    User     @relation("ParentChildren", fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("ParentStudents", fields: [studentId], references: [id], onDelete: Cascade)
  canEdit   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

model Certificate {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificateId     String   @unique
  courseId          String
  courseTitle       String
  completionPercent Int
  studentName       String
  teacherName       String
  issuedAt          DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([certificateId])
}

model XpLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

model Badge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  name        String
  description String
  icon        String   @default("Award")
  awardedAt   DateTime @default(now())

  @@unique([userId, type])
  @@index([userId])
}

model Subscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       String
  classKey   String?
  amount     Int
  status     String   @default("pending") // pending | under_review | approved | rejected | cancelled
  startDate  DateTime?
  expiryDate DateTime?
  paymentId  String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiryDate])
}

model Session {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  deviceId     String?
  deviceName   String?
  browser      String?
  os           String?
  userAgent    String?
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([userId, deviceId])
}

model SiteSetting {
  id              String @id @default("platform")
  landingVideoUrl String @default("k3sRZvSlBNE")
  teacherName     String @default("منصة الرائد")
  maxDevices      Int    @default(3)
}

model Topic {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String
  grade       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
  pdfs        Pdf[]
  quizzes     Quiz[]
  questions   Question[]

  @@index([grade, order])
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  description String
  videoUrl    String
  duration    String
  type        String   @default("explanation")
  accessType  String   @default("FREE") // FREE | SUBSCRIBER | PREMIUM
  summary     String?
  keyPoints   Json?
  files       Json?
  grade       String?
  order       Int      @default(0)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  progress   UserLessonProgress[]
  questions  Question[]

  @@index([topicId, order])
  @@index([grade, order])
}

model Payment {
  id             String   @id @default(cuid())
  userId         String
  amount         Int
  plan           String
  classKey       String?
  paymentMethod  String   @default("vodafone_cash")
  transactionId  String?
  status         String   @default("pending")
  vodafoneRef    String?
  activationCode String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model SubscriptionCode {
  id        String    @id @default(cuid())
  code      String    @unique
  plan      String
  isUsed    Boolean   @default(false)
  usedBy    String?
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model Pdf {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  category    String   @default("explanation")
  accessType  String   @default("FREE") // FREE | SUBSCRIBER | PREMIUM
  grade       String?
  order       Int      @default(0)
  topicId     String?
  topic       Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([grade, order])
  @@index([topicId, order])
}

model Quiz {
  id           String             @id @default(cuid())
  title        String
  description  String?
  accessType   String             @default("FREE") // FREE | SUBSCRIBER | PREMIUM
  grade        String?
  topicId      String
  topic        Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  timeLimit    Int?
  passingScore Int                @default(70)
  questions    Question[]
  progress     UserQuizProgress[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([grade, createdAt])
  @@index([topicId])
}

model Question {
  id            String   @id @default(cuid())
  question      String
  type          String   @default("multiple-choice")
  options       String[]
  correctAnswer String
  difficulty    String   @default("medium") // easy | medium | hard
  explanation   String?
  points        Int      @default(1)
  tags          String[] @default([])
  topicId       String?
  topic         Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  lessonId      String?
  lesson        Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  quizId        String?
  quiz          Quiz?    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([quizId, difficulty])
  @@index([topicId, difficulty])
  @@index([lessonId])
  @@index([createdAt])
}

model UserQuizProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Int
  passed      Boolean
  attempts    Int      @default(1)
  bestScore   Int      @default(0)
  answers     Json?
  completedAt DateTime @default(now())

  @@unique([userId, quizId])
  @@index([userId, completedAt])
  @@index([completedAt])
}

model UserLessonProgress {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId         String
  lesson           Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress         Int      @default(0)
  watchSeconds     Int      @default(0)
  timeSpentSeconds Int      @default(0)
  completed        Boolean  @default(false)
  completedAt      DateTime?
  updatedAt        DateTime @default(now()) @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, completedAt])
  @@index([updatedAt])
}

model Advice {
  id          String   @id @default(cuid())
  title       String
  content     String
  videoUrl    String?
  type        String   @default("text")
  grade       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType  String   // lesson | pdf | question
  itemId    String
  title     String
  context   String?
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // new_lesson | new_quiz | new_pdf | announcement | subscription_expiring | quiz_result | achievement
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId])
}
